{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://dhilipsiva.com/nibli-learn/content/offline-pack.schema.json",
  "title": "Nibli Learn offline content pack metadata, reserved schema 1",
  "description": "Contract only. Phase 1 does not implement external pack import or activation.",
  "type": "object",
  "additionalProperties": false,
  "required": ["schema", "kind", "id", "version", "content_version", "app_schema", "engine_revision", "content_manifest", "files"],
  "properties": {
    "schema": { "const": 1 },
    "kind": { "const": "nibli-content-pack" },
    "id": { "type": "string", "pattern": "^[a-z][a-z0-9.-]{0,127}$" },
    "version": { "type": "integer", "minimum": 1 },
    "content_version": { "type": "integer", "minimum": 1 },
    "app_schema": { "const": 1 },
    "engine_revision": { "type": "string", "pattern": "^[a-f0-9]{40}$" },
    "content_manifest": { "$ref": "#/$defs/path" },
    "files": {
      "type": "array",
      "minItems": 1,
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": ["path", "sha256", "bytes", "media_type"],
        "properties": {
          "path": { "$ref": "#/$defs/path" },
          "sha256": { "type": "string", "pattern": "^[a-f0-9]{64}$" },
          "bytes": { "type": "integer", "minimum": 0 },
          "media_type": { "enum": ["application/json", "text/markdown", "image/png", "image/jpeg", "image/webp", "image/avif"] }
        }
      }
    }
  },
  "$defs": {
    "path": {
      "type": "string",
      "minLength": 1,
      "maxLength": 512,
      "pattern": "^[a-zA-Z0-9_-][a-zA-Z0-9_./-]*$",
      "not": { "pattern": "(^|/)\\.{1,2}(/|$)|//|/$" }
    }
  }
}
