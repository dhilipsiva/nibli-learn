{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://dhilipsiva.dev/nibli-learn/content/offline-pack.schema.json",
  "title": "Nibli Learn declarative offline content pack, schema 1",
  "description": "First-party catalog pins the manifest hash. Runtime code uses a separate manifest and immutable namespace.",
  "type": "object",
  "additionalProperties": false,
  "allOf": [{
    "if": { "properties": { "engine_revision": { "pattern": "^local-" } } },
    "then": { "required": ["development"], "properties": { "development": { "const": true } } }
  }],
  "required": ["schema", "kind", "id", "version", "content_version", "app_schema", "engine_revision", "base_path", "content_manifest", "content_digest", "files"],
  "properties": {
    "schema": { "const": 1 },
    "kind": { "const": "nibli-content-pack" },
    "id": { "type": "string", "pattern": "^[a-z][a-z0-9.-]{0,127}$" },
    "version": { "type": "integer", "minimum": 1 },
    "content_version": { "type": "integer", "minimum": 1 },
    "app_schema": { "const": 2 },
    "engine_revision": { "type": "string", "pattern": "^([a-f0-9]{40}|local-[a-f0-9]{40}-source-[a-f0-9]{16})$" },
    "development": { "type": "boolean" },
    "content_manifest": { "$ref": "#/$defs/path" },
    "base_path": { "type": "string", "pattern": "^/nibli-learn/packs/[a-z][a-z0-9.-]*/[1-9][0-9]*/$" },
    "content_digest": { "type": "string", "pattern": "^[a-f0-9]{64}$" },
    "files": {
      "type": "array",
      "minItems": 1,
      "maxItems": 2048,
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": ["path", "sha256", "bytes", "media_type"],
        "properties": {
          "path": { "$ref": "#/$defs/path" },
          "sha256": { "type": "string", "pattern": "^[a-f0-9]{64}$" },
          "bytes": { "type": "integer", "minimum": 0, "maximum": 134217728 },
          "media_type": { "enum": ["application/json", "text/markdown", "image/png", "image/jpeg", "image/webp", "image/avif"] }
        }
      }
    }
  },
  "$defs": {
    "path": {
      "type": "string",
      "minLength": 1,
      "maxLength": 512,
      "pattern": "^[a-zA-Z0-9_-][a-zA-Z0-9_./-]*$",
      "not": { "pattern": "(^|/)\\.{1,2}(/|$)|//|/$" }
    }
  }
}
